# Server-side only. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PIXELCUT_API_KEY=
PIXELCUT_ENDPOINT=

# System-wide segmentation provider. "auto" uses fal when FAL_KEY exists,
# otherwise Replicate. Provider masks remain subject to VisionCore validation.
FAL_KEY=
VISIONCORE_SEGMENTATION_PROVIDER=auto
VISIONCORE_SEGMENTATION_FALLBACK_PROVIDER=replicate
FAL_TARGET_SEGMENTATION_MODEL=fal-ai/sam-3-1/image
FAL_AUTO_SEGMENTATION_MODEL=fal-ai/sam2/auto-segment
REPLICATE_API_TOKEN=

# VisionCore governed semantic observer.
OPENAI_API_KEY=
VISIONCORE_EXTERNAL_INTELLIGENCE_MODE=shadow
OPENAI_SEMANTIC_MODEL=gpt-5.6-luna
OPENAI_SEMANTIC_TIMEOUT_MS=30000

# Live benchmark collection is opt-in per upload. The client must send
# benchmarkMode=true or X-VisionCore-Benchmark: collect. Records are stored as
# authenticated raw Cloudinary assets and are not ground truth until adjudicated.
VISIONCORE_BENCHMARK_COLLECTION=opt_in
